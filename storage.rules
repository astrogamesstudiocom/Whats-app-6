rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{conversationId}/{senderId}/{fileName} {
      allow read: if request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/ai-studio-85f04a81-d937-4317-af8b-4e9baa13de1d/documents/conversations/$(conversationId)/members/$(request.auth.uid));
      allow write: if request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.uid == senderId &&
        request.resource.size <= 50 * 1024 * 1024 &&
        (
          request.resource.contentType == 'application/octet-stream' ||
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'text/plain' ||
          request.resource.contentType.matches('application/vnd\\..*') ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/zip'
        );
    }

    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.uid == userId &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /groups/{conversationId}/{fileName} {
      allow read: if request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/ai-studio-85f04a81-d937-4317-af8b-4e9baa13de1d/documents/conversations/$(conversationId)/members/$(request.auth.uid));
      allow write: if request.auth != null &&
        request.auth.token.email_verified == true &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') &&
        firestore.get(/databases/ai-studio-85f04a81-d937-4317-af8b-4e9baa13de1d/documents/conversations/$(conversationId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
