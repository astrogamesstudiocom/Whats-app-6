  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Public directory profile, presence status, and E2EE public key."
    },
    "/users/{userId}/private/account": {
      "schema": {
        "$ref": "#/entities/PrivateAccount"
      },
      "description": "Private PII and FCM token storage accessible only by the owning user."
    },
    "/users/{userId}/private/keyBackup": {
      "schema": {
        "$ref": "#/entities/PrivateKeyBackup"
      },
      "description": "Passphrase-encrypted E2EE private key backup accessible only by the owning user."
    },
    "/users/{userId}/conversationRefs/{conversationId}": {
      "schema": {
        "$ref": "#/entities/ConversationRef"
      },
      "description": "User-scoped conversation index for real-time inbox rendering."
    },
    "/users/{userId}/callInvites/{callId}": {
      "schema": {
        "$ref": "#/entities/CallInvite"
      },
      "description": "User-scoped incoming call alerts and call history."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/UserNotification"
      },
      "description": "User-scoped missed call and message notifications."
    },
    "/emailDirectory/{emailHash}": {
      "schema": {
        "$ref": "#/entities/EmailDirectoryEntry"
      },
      "description": "Exact SHA-256 email hash lookup for private contact discovery."
    },
    "/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Conversation metadata for 1:1 and group chats."
    },
    "/conversations/{conversationId}/members/{memberId}": {
      "schema": {
        "$ref": "#/entities/ConversationMember"
      },
      "description": "Membership records, roles, and delivery/read receipt watermarks."
    },
    "/conversations/{conversationId}/keyEnvelopes/{envelopeId}": {
      "schema": {
        "$ref": "#/entities/ConversationKeyEnvelope"
      },
      "description": "Per-epoch E2EE wrapped symmetric room keys addressed to conversation members."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "End-to-end encrypted messages belonging to a conversation."
    },
    "/conversations/{conversationId}/typing/{userId}": {
      "schema": {
        "$ref": "#/entities/TypingIndicator"
      },
      "description": "Real-time typing state per conversation member."
    },
    "/calls/{callId}": {
      "schema": {
        "$ref": "#/entities/CallSession"
      },
      "description": "WebRTC call session metadata and lifecycle state."
    },
    "/calls/{callId}/participants/{participantId}": {
      "schema": {
        "$ref": "#/entities/CallParticipant"
      },
      "description": "Participants and live media mute state in a call."
    },
    "/calls/{callId}/signals/{signalId}": {
      "schema": {
        "$ref": "#/entities/WebRtcSignal"
      },
      "description": "Peer-to-peer WebRTC SDP and ICE signaling packets."
    },
    "/test/{docId}": {
      "schema": {
        "$ref": "#/entities/ConnectionCheck"
      },
      "description": "Connectivity verification endpoint."
    }
  }
}
