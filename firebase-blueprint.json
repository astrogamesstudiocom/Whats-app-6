  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public directory profile, real-time online presence, and E2EE identity public key.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        },
        "statusText": {
          "type": "string",
          "maxLength": 140
        },
        "identityPublicKey": {
          "type": "string",
          "maxLength": 256
        },
        "keyFingerprint": {
          "type": "string",
          "maxLength": 128
        },
        "discoverable": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "discoverable",
        "online",
        "lastSeen",
        "createdAt",
        "updatedAt"
      ]
    },
